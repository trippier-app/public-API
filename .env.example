#################################### poi-api ###################################
POI_CACHE_TTL_SECONDS=3600
POI_PROVIDER_TIMEOUT=28
POI_MERGE_TIMEOUT=8
POI_LANG=en
POI_LOG_LEVEL=info

# Optional — free account at https://www.geonames.org/login
POI_GEONAMES_USERNAME=

################################ itinerary-api #################################
POI_CLIENT_TIMEOUT=10.0
LOG_LEVEL=info

################################# Internal auth ################################
# One value shared by every Trippier service (landing, app front, both APIs):
# calls carrying a valid X-Internal-Auth skip the API-key quota, everyone else
# needs an X-API-Key. At least 16 chars — openssl rand -hex 32.
INTERNAL_SECRET=change-me-internal-secret

# Set to true ONLY to run the APIs wide open, with no key and no rate limiting.
POI_AUTH_DISABLED=false
AUTH_DISABLED=false

#################### Ports (host side, docker-compose.yml) ######################
POI_API_PORT=8080
ITINERARY_API_PORT=8000
